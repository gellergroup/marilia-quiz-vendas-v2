.intro-cta svg { transition: transform .25s ease; }
.intro-cta:hover svg { transform: translateX(4px); }
.intro-assurance { margin: 10px 0 0; color: #938b93; font-size: 10px; }

/* Progress bar */
.progress-container {
  width: 100%;
  background-color: rgba(147, 148, 152, 0.2);
  height: 6px;
  border-radius: 3px;
  margin-bottom: 2.5rem;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  border-radius: 3px;
}

/* Options */
.question-header {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.question-number {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--color-primary);
  opacity: 0.8;
  font-family: var(--font-sans);
}

.premium-option {
  display: flex;
  align-items: center;
  padding: 1.2rem 1.5rem;
  border: 2px solid rgba(147, 148, 152, 0.3);
  border-radius: 12px;
  margin-bottom: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  background: #fff;
  opacity: 0;
  animation: slideInRight 0.5s ease forwards;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(20px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.premium-option:hover {
  border-color: var(--color-primary-light);
  transform: translateX(5px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
}

.premium-option.selected {
  border-color: var(--color-primary);
  background-color: rgba(183, 26, 123, 0.05);
  box-shadow: 0 5px 15px rgba(183, 26, 123, 0.1);
}

.custom-checkbox {
  width: 24px;
  height: 24px;
  border: 2px solid var(--color-gray-light);
  border-radius: 50%;
  margin-right: 1.2rem;
  position: relative;
  transition: all 0.2s;
  flex-shrink: 0;
}

.premium-option.selected .custom-checkbox {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.custom-checkbox::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 10px;
  height: 10px;
  background: #fff;
  border-radius: 50%;
  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.premium-option.selected .custom-checkbox::after {
  transform: translate(-50%, -50%) scale(1);
}

.option-input {
  display: none;
}

/* Form Styles */
.benefits-list {
  margin: 2rem 0;
}

.benefit-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 1.5rem;
}

.benefit-icon {
  background: var(--color-primary);
