:root {
  --color-primary: #B71A7B;
  --color-primary-light: #d13a96;
  --color-dark: #221E1F;
  --color-gray-dark: #58585A;
  --color-gray-light: #939498;
  --color-bg: #EEE7DB;

  --font-sans: 'Montserrat', sans-serif;
  --font-serif: 'Montserrat', serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-sans);
  background: linear-gradient(135deg, #fdfbf7 0%, var(--color-bg) 100%);
  background-attachment: fixed;
  color: var(--color-dark);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.6;
  min-height: 100vh;
}

/* Typography */
.serif-heading {
  font-family: var(--font-serif);
  font-weight: 700;
  letter-spacing: -0.5px;
}

.gradient-text {
  background: linear-gradient(135deg, var(--color-primary) 0%, #8a135c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.subtitle {
  font-size: 1.1rem;
  color: var(--color-gray-dark);
  margin-bottom: 2rem;
  font-weight: 400;
}

h2 {
  font-size: 2.2rem;
  margin-bottom: 1.5rem;
  line-height: 1.2;
}

h3 {
  font-size: 1.8rem;
  margin-bottom: 1rem;
}

p {
  margin-bottom: 1.2rem;
  font-size: 1.05rem;
}

.text-center {
  text-align: center;
}

.mb-4 {
  margin-bottom: 1rem;
}

.mb-8 {
  margin-bottom: 2rem;
}

.mt-4 {
  margin-top: 1rem;
}

.mt-8 {
  margin-top: 2rem;
}

.inline-block {
  display: inline-block;
}

.text-sm {
  font-size: 0.9rem;
}

/* Layout */
.container {
  max-width: 800px;
  margin: 0 auto;
  padding: 2rem;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card {
  width: 100%;
}

.premium-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 3rem;
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(34, 30, 31, 0.08),
    0 1px 3px rgba(34, 30, 31, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
}

/* Glass Panel */
.glass-panel {
  background: rgba(238, 231, 219, 0.3);
  padding: 2rem;
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.6);
}

/* Buttons */
button {
  font-family: var(--font-sans);
  cursor: pointer;
  border: none;
  border-radius: 50px;
  font-size: 1.1rem;
  font-weight: 600;
  padding: 1.2rem 2.5rem;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
}

button,
.premium-option,
a {
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
.premium-option:focus-visible,
a:focus-visible {
  outline: 3px solid rgba(183, 26, 123, .3);
  outline-offset: 3px;
}

.primary-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
  box-shadow: 0 10px 20px rgba(183, 26, 123, 0.2);
}

.primary-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 15px 25px rgba(183, 26, 123, 0.3);
}

.primary-btn:active:not(:disabled) {
  transform: translateY(1px);
}

.primary-btn:disabled {
  background: var(--color-gray-light);
  box-shadow: none;
  cursor: not-allowed;
  opacity: 0.7;
}

.secondary-btn {
  background: transparent;
  color: var(--color-gray-dark);
  border: 2px solid var(--color-gray-light);
  padding: 1.1rem 2.4rem;
}

.secondary-btn:hover {
  background: var(--color-gray-light);
  color: #fff;
}

.glow-btn {
  position: relative;
  z-index: 1;
}

.glow-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50px;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  z-index: -1;
  filter: blur(15px);
  opacity: 0.5;
  transition: opacity 0.3s ease;
  animation: pulse-glow 2s infinite;
}

@keyframes pulse-glow {
  0% {
    transform: scale(0.95);
    opacity: 0.5;
  }

  50% {
    transform: scale(1.05);
    opacity: 0.8;
  }

  100% {
    transform: scale(0.95);
    opacity: 0.5;
  }
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 2rem;
}

/* Animations */
.fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

