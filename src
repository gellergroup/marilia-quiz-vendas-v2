  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--color-gray-light);
}

.coupon-code {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: 4px;
}

.coupon-desc {
  font-size: 0.95rem;
  opacity: 0.9;
}

.coupon-copy-status {
  display: inline-flex;
