  letter-spacing: .3px;
}

.coupon-box.is-copied .coupon-copy-status { color: #fff; background: #b71a7b; }

@keyframes couponGlow {
  0%, 100% { box-shadow: 0 0 0 rgba(226, 34, 130, 0), inset 0 0 0 rgba(226,34,130,0); }
  50% { box-shadow: 0 0 24px rgba(226, 34, 130, .38), inset 0 0 18px rgba(226,34,130,.1); }
}

@keyframes couponShine {
  0%, 22% { left: -45%; opacity: 0; }
  35% { opacity: 1; }
  62%, 100% { left: 125%; opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .coupon-box,
  .coupon-box::before { animation: none; }
}

.final-quote {
