    transform: rotate(360deg);
  }
}

/* Results */
.badge {
  background: rgba(88, 88, 90, 0.1);
  color: var(--color-gray-dark);
  padding: 0.5rem 1.2rem;
  border-radius: 50px;
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.heatmap-wrapper {
  position: relative;
  margin: 3rem 0;
}

.heatmap-container {
  width: 100%;
  height: 20px;
  background: linear-gradient(to right, #e0e0e0, var(--color-primary));
  border-radius: 10px;
  position: relative;
}

.heatmap-marker {
  position: absolute;
  top: 50%;
  width: 24px;
  height: 24px;
  background: #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 4px solid var(--color-dark);
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.5);
  transition: left 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.pulse-marker::before {
  content: '';
  position: absolute;
  top: -10px;
  left: -10px;
  right: -10px;
  bottom: -10px;
  border-radius: 50%;
  border: 2px solid var(--color-dark);
  animation: ripple 2s infinite cubic-bezier(0.65, 0, 0.34, 1);
}

@keyframes ripple {
  from {
    transform: scale(0.5);
    opacity: 1;
  }

  to {
    transform: scale(2);
    opacity: 0;
  }
}

.heatmap-tooltip {
  position: absolute;
  top: -40px;
  transform: translateX(-50%);
  background: var(--color-dark);
  color: #fff;
  padding: 0.4rem 0.8rem;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 600;
  white-space: nowrap;
}

.heatmap-tooltip::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 8px;
  height: 8px;
  background: var(--color-dark);
}

.heatmap-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 1rem;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-gray-dark);
}

.divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(147, 148, 152, 0.3), transparent);
  margin: 3rem 0;
}

.highlight-text {
  font-weight: 700;
  color: var(--color-primary);
  font-size: 1.1rem;
}

.anticipation-text {
  font-style: italic;
  font-weight: 700;
  text-align: center;
  font-size: 1.15rem;
  margin-top: 2rem;
}

.gift-section {
  background: var(--color-dark);
  color: #fff;
  padding: 3rem;
  border-radius: 20px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.gift-section::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(183, 26, 123, 0.2) 0%, transparent 70%);
  z-index: 0;
}

.gift-section>* {
  position: relative;
  z-index: 1;
}

.coupon-box {
  position: relative;
  overflow: hidden;
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 2px dashed rgba(183, 26, 123, 0.8);
  border-radius: 12px;
  padding: 2rem;
  margin: 2rem auto;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: inherit;
  font-family: inherit;
  text-transform: none;
  letter-spacing: normal;
  cursor: pointer;
  animation: couponGlow 2.2s ease-in-out infinite;
  isolation: isolate;
}

.coupon-box::before {
  content: '';
  position: absolute;
  z-index: 0;
  top: -70%;
  bottom: -70%;
  left: -45%;
  width: 28%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.24), transparent);
  transform: rotate(18deg);
  animation: couponShine 2.8s ease-in-out infinite;
  pointer-events: none;
}

.coupon-box > * { position: relative; z-index: 1; }

.coupon-box:hover {
  border-color: #f23b98;
  background: rgba(255,255,255,.08);
}

.coupon-box:active { transform: scale(.985); }
.coupon-box.is-copied { border-style: solid; border-color: #ff5aab; background: rgba(183,26,123,.16); }

.coupon-label {
