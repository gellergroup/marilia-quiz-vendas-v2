@media (max-width: 700px) {
  .result-page { padding: 24px 12px; }
  .result-header { padding: 0 5px 20px; }
  .result-header h1 { font-size: 34px; letter-spacing: -1px; }
  .heatmap-section { margin: 0; padding: 26px 22px; }
  .diagnostic-copy { padding: 30px 3px 18px; }
  .copy-row { grid-template-columns: 58px 1fr; gap: 15px; align-items: start; }
  .round-icon { width: 58px; height: 58px; }.round-icon svg { width: 28px; }
  .copy-row p { font-size: 13px; }
  .explanation-section { padding: 22px 18px; }
  .explanation-grid { grid-template-columns: 1fr; gap: 18px; }
  .explanation-copy { padding: 0; border: 0; }.explanation-copy h2 { font-size: 29px; }
  .anticipation { gap: 12px; font-size: 13px; }
  .gift-section { grid-template-columns: 1fr; padding: 25px 20px; }
  .gift-visual { flex-direction: row; justify-content: center; }.gift-visual img { width: 180px; height: 180px; }
  .gift-content h2 { font-size: 25px; }.gift-content p { font-size: 13px; }
  .shop-button { min-height: 46px; padding: 11px 18px; }
  .footer-warning { grid-template-columns: 55px 1fr; }.footer-warning p { grid-column: 1 / -1; margin-top: 10px; }
}

